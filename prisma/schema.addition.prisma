// Merge this model into the schema.prisma generated by Shopify's current
// React Router app template. Keep the template's Session model unchanged.

model CollectionSetting {
  id                String   @id @default(cuid())
  shop              String
  collectionId      String
  enabled           Boolean  @default(false)
  previousSortOrder String?
  lastSortedAt      DateTime?
  lastError         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([shop, collectionId])
  @@index([shop, enabled])
}
