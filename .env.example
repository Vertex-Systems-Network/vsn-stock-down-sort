# Runtime environment: development | staging | production
APP_ENV=development

# true for development/staging; false only for live production.
SHOPIFY_BILLING_TEST_MODE=true

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_products,write_products,read_inventory

# Neon PostgreSQL is the target database provider for Local, Staging, and Production.
# Each tier must be isolated. Runtime traffic uses the pooled Neon URL.
DATABASE_URL=
# Matching direct/non-pooled Neon URL used only by Prisma migration commands.
DIRECT_URL=

# Optional custom shop domain support.
SHOP_CUSTOM_DOMAIN=

# Hosted low-stock email alerts. Must use a sender on a domain onboarded to
# Cloudflare Email Service. Do not set this for normal Local development.
ALERT_FROM_EMAIL=
