# Runtime environment: development | staging | production
APP_ENV=development

# true for local/dev and staging, false for live production.
SHOPIFY_BILLING_TEST_MODE=true

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_products,write_products,read_inventory

# Optional custom shop domain support.
SHOP_CUSTOM_DOMAIN=

# Staging/production only. Local development keeps using SQLite.
# DATABASE_URL may use a pooled PostgreSQL endpoint.
DATABASE_URL=
# DIRECT_URL should be a direct PostgreSQL endpoint for Prisma migrations.
DIRECT_URL=
