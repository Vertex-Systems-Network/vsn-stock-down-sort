# Runtime environment: development | staging | production
APP_ENV=development

# true for development/staging; false only for live production.
SHOPIFY_BILLING_TEST_MODE=true

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_products,write_products,read_inventory

# PostgreSQL is used in every runtime tier.
# Use an environment-isolated runtime/pooler URL.
DATABASE_URL=
# Direct PostgreSQL connection used only by Prisma migration commands.
DIRECT_URL=

# Optional custom shop domain support.
SHOP_CUSTOM_DOMAIN=
