# Local/Development only.
# The Local runner explicitly loads .env.local first, with .env only as a fallback.
# Copy this file to .env.local and replace placeholders.
# Never reuse Staging or Production database or Shopify credentials.

# Dedicated Local Neon project identity. The ID must be the real Neon project ID.
NEON_PROJECT_NAME=vsn-stock-down-sort-local
NEON_PROJECT_ID=REPLACE_WITH_REAL_NEON_PROJECT_ID
# Required by local:provision-neon and local:certify to verify the real project/endpoint binding.
# Keep this only in the gitignored local environment; never commit a real token.
NEON_API_KEY=REPLACE_WITH_LOCAL_NEON_API_KEY
# Runtime traffic MUST use the pooled hostname containing "-pooler".
DATABASE_URL=postgresql://USER:PASSWORD@ep-local-example-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Prisma migrations MUST use the matching direct hostname without "-pooler".
DIRECT_URL=postgresql://USER:PASSWORD@ep-local-example.REGION.aws.neon.tech/neondb?sslmode=require

# Dedicated Shopify app: VSN | Stock Down Sort Dev
SHOPIFY_API_KEY=675de0e3834ce61a75473de19df457c4
SHOPIFY_API_SECRET=local-development-app-client-secret

# Shopify CLI manages the tunnel/application URL during npm run dev.
SCOPES=read_products,write_products,read_inventory
APP_ENV=development
SHOPIFY_BILLING_TEST_MODE=true
