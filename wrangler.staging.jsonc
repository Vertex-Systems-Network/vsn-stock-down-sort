{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "vsn-stock-down-sort-staging",
  "main": "./workers/app.js",
  "compatibility_date": "2026-09-29",
  "assets": {
    "directory": "build/client"
  },
  "observability": {
    "enabled": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "secrets": {
    "required": [
      "DATABASE_URL",
      "SHOPIFY_API_KEY",
      "SHOPIFY_API_SECRET"
    ]
  },
  "vars": {
    "APP_ENV": "staging",
    "SHOPIFY_BILLING_TEST_MODE": "true",
    "SHOPIFY_APP_URL": "https://vsn-stock-down-sort-staging.vertexsystemsnetwork.workers.dev",
    "SCOPES": "read_products,write_products,read_inventory"
  },
  "queues": {
    "producers": [
      {
        "queue": "vsn-stock-down-sort-staging-sort-jobs",
        "binding": "STOCK_SORT_QUEUE"
      }
    ],
    "consumers": [
      {
        "queue": "vsn-stock-down-sort-staging-sort-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "dead_letter_queue": "vsn-stock-down-sort-staging-sort-jobs-dlq",
        "max_concurrency": 1,
        "retry_delay": 10
      }
    ]
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  }
}
