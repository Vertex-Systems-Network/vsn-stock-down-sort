{
  "schema_version": 1,
  "repository": "Vertex-Systems-Network/vsn-stock-down-sort",
  "order": [
    "local",
    "staging",
    "production"
  ],
  "local": {
    "git_branch": "development",
    "shopify_app": "VSN | Stock Down Sort Dev",
    "shopify_config": "shopify.app.local.toml",
    "runtime": "local_shopify_cli",
    "database": {
      "provider": "sqlite",
      "file": "prisma/dev.sqlite",
      "schema": "prisma/schema.prisma",
      "status": "local_file_runtime",
      "gitignored": true,
      "hosted_credentials_required": false,
      "reuse_staging_or_production": false
    },
    "command": "npm run dev",
    "billing_test_mode": true,
    "cloud_verification": {
      "runtime": "github_actions_ephemeral_sqlite",
      "schema": "prisma/schema.prisma",
      "fresh_database_per_run": true,
      "persistent_merchant_preview": false,
      "requires_hosted_credentials": false
    }
  },
  "staging": {
    "github_environment": "cloudflare-staging",
    "github_environment_url": "https://github.com/Vertex-Systems-Network/vsn-stock-down-sort/settings/environments/23050370538/edit",
    "source_branch": "development",
    "worker": "vsn-stock-down-sort-staging",
    "database": {
      "provider": "neon_postgresql",
      "isolated_from_local_and_production": true
    },
    "billing_test_mode": true,
    "deploy": "manual",
    "shopify_app": "VSN | Stock Down Sort Staging"
  },
  "production": {
    "github_environment": "cloudflare-production",
    "github_environment_url": "https://github.com/Vertex-Systems-Network/vsn-stock-down-sort/settings/environments/23098399859/edit",
    "source_branch": "main",
    "worker": "vsn-stock-down-sort-production",
    "database": {
      "provider": "neon_postgresql",
      "isolated_from_local_and_staging": true
    },
    "billing_test_mode": false,
    "deploy": "manual_and_authorized",
    "shopify_app": "VSN | Stock Down Sort",
    "client_id_source": "committed_shopify_app_production_toml"
  }
}
